      "item": [
        {
          "name": "Register - Personal Workspace",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  if (data.user && data.user.id) pm.collectionVariables.set('user_id', data.user.id);",
                  "  if (data.organizationId) pm.collectionVariables.set('organization_id', data.organizationId);",
                  "  if (data.projectId) pm.collectionVariables.set('project_id', data.projectId);",
                  "  if (data.verificationToken) pm.collectionVariables.set('verification_token', data.verificationToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Password123!\",\n  \"firstName\": \"Abdur\",\n  \"lastName\": \"Rehman\",\n  \"displayName\": \"Abdur Rehman\",\n  \"workspaceType\": \"personal\",\n  \"projectName\": \"My Project\"\n}"
            },
            "url": "{{base_url}}/auth/register"
