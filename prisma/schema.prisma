generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model Blueprint {
    id               String   @id @default(cuid())
    name             String
    description      String?
    fileUrl          String
    originalFileName String?
    mimeType         String?
    fileSizeBytes    Int?
    pageCount        Int      @default(0)
    processingStatus BlueprintProcessingStatus @default(READY)
    processingError  String?
    processedAt      DateTime?
    metadata         Json?
    createdAt        DateTime @default(now())
    updatedAt        DateTime @updatedAt

    pages BlueprintPage[]
}

model BlueprintPage {
    id          String   @id @default(cuid())
    blueprintId String
    pageNumber  Int
    imageUrl    String?
    width       Int?
    height      Int?
    metadata    Json?
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    blueprint    Blueprint     @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
    calibrations Calibration[]
    shapes       Shape[]

    @@unique([blueprintId, pageNumber])
    @@index([blueprintId])
}

model Calibration {
    id              String   @id @default(cuid())
    blueprintPageId String
    pixelsPerUnit  Float
    unit           String
    referenceLabel String?
    referenceStart Json?
    referenceEnd   Json?
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    blueprintPage BlueprintPage @relation(fields: [blueprintPageId], references: [id], onDelete: Cascade)

    @@index([blueprintPageId])
}

model Shape {
    id          String    @id @default(cuid())
    blueprintPageId String
    type        ShapeType
    label       String?
    measurement Float?
    unit        String?
    fillColor   String?
    strokeColor String?
    metadata    Json?
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    blueprintPage BlueprintPage @relation(fields: [blueprintPageId], references: [id], onDelete: Cascade)
    points        ShapePoint[]

    @@index([blueprintPageId])
}

model ShapePoint {
    id      String @id @default(cuid())
    shapeId String
    x       Float
    y       Float
    order   Int

    shape Shape @relation(fields: [shapeId], references: [id], onDelete: Cascade)

    @@unique([shapeId, order])
    @@index([shapeId])
}

enum ShapeType {
    LINE
    POLYLINE
    POLYGON
}

enum BlueprintProcessingStatus {
    PROCESSING
    READY
    FAILED
}
